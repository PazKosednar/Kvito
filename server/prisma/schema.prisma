// Kvito data model.
// Conventions: money in integer cents (EUR), timestamps in UTC, soft delete via `deletedAt`.
// Models for later phases (Message, Issue, MeterReading, Handover, Document, ...) are added with their own migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  LANDLORD
  TENANT
}

enum Locale {
  sl
  en
}

enum TenancyStatus {
  DRAFT
  ACTIVE
  ENDED
}

/// How a shared cost is split between tenancy members.
enum SplitMethod {
  EQUAL // equal parts
  PERCENTAGE // TenancyMember.shareBasisPoints
  PER_PERSON // weighted by TenancyMember.personCount
}

/// Cost categories a landlord can mark as covered by the tenant. No legal defaults are implied.
enum CostType {
  RENT
  ELECTRICITY
  WATER
  GAS
  HEATING
  WASTE
  INTERNET
  TV
  MAINTENANCE_FUND
  BUILDING_MANAGEMENT
  CLEANING
  OTHER
}

enum BillingMode {
  COMBINED
  SEPARATE
}

enum ChargeType {
  RENT
  BILL
  OTHER
  /// Payment of the security deposit (varščina) – linked from Deposit.chargeId.
  DEPOSIT
  /// Monthly advance for running costs (akontacija), generated from CostAdvance.
  ADVANCE
  /// Additional payment from a cost settlement (poračun), linked from CostSettlement.chargeId.
  SETTLEMENT
}

enum ChargeStatus {
  OPEN
  REPORTED_PAID
  CONFIRMED
  OVERDUE
  DISPUTED
}

/// Who receives the payment: the landlord (UPN QR generated by Kvito) or the supplier directly (data from the original bill).
enum PayTo {
  LANDLORD
  SUPPLIER
}

enum PaymentReportStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Where a payment record came from: the tenant's "I paid", the landlord's bank statement, or the landlord directly.
enum PaymentSource {
  TENANT
  BANK_IMPORT
  LANDLORD
}

// ---------- Users & auth ----------

model User {
  id             String    @id @default(cuid())
  email          String    @unique // always stored lowercased
  name           String?
  phone          String?
  locale         Locale    @default(sl)
  roles          Role[]    @default([])
  lastActiveRole Role?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  refreshTokens       RefreshToken[]
  properties          Property[]         @relation("PropertyOwner")
  memberships         TenancyMember[]
  invitationsSent     Invitation[]       @relation("InvitationInviter")
  invitationsAccepted Invitation[]       @relation("InvitationAcceptedBy")
  chargesCreated      Charge[]           @relation("ChargeCreatedBy")
  sharesConfirmed     ChargeShare[]      @relation("ChargeShareConfirmedBy")
  paymentReports      PaymentReport[]    @relation("PaymentReportReporter")
  paymentReviews      PaymentReport[]    @relation("PaymentReportReviewer")
  auditLogs           AuditLog[]
  attachments         Attachment[]
  messages            Message[]
  conversationReads   ConversationRead[]
  issuesReported      Issue[]
  issueComments       IssueComment[]
  documents           Document[]
  meterReadings       MeterReading[]
  handoversCreated    Handover[]         @relation("HandoverCreatedBy")
  handoversConfirmed  Handover[]         @relation("HandoverTenantConfirmedBy")
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]
}

/// One-time login code. Only an HMAC of the code is stored.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// Refresh token session. Rotated on every use; reuse of a rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ---------- Properties & tenancies ----------

model Property {
  id         String    @id @default(cuid())
  ownerId    String
  name       String
  street     String
  postalCode String
  city       String
  country    String    @default("SI")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  owner User   @relation("PropertyOwner", fields: [ownerId], references: [id])
  units Unit[]

  @@index([ownerId])
}

model Unit {
  id         String    @id @default(cuid())
  propertyId String
  name       String
  floor      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  property      Property       @relation(fields: [propertyId], references: [id])
  tenancies     Tenancy[]
  meterReadings MeterReading[]
  documents     Document[]

  @@index([propertyId])
}

model Tenancy {
  id               String        @id @default(cuid())
  unitId           String
  status           TenancyStatus @default(DRAFT)
  startDate        DateTime      @db.Date
  endDate          DateTime?     @db.Date
  rentCents        Int
  /// Day of month rent is due (1-31; clamped to the last day of shorter months).
  rentDueDay       Int
  depositCents     Int?
  payeeName        String
  payeeIban        String
  payeeStreet      String?
  payeeCity        String?
  /// Costs the tenant covers, as configured by the landlord.
  coveredCosts     CostType[]    @default([])
  splitMethod      SplitMethod   @default(EQUAL)
  /// Notice period in days as written in the contract. Entered by the landlord; Kvito implies no legal default.
  noticePeriodDays Int?
  /// Month (1–12) in which the landlord wants a reminder to review the rent (e.g. indexation per contract).
  rentReviewMonth  Int?
  /// Informative note for other ways to pay, e.g. "Flik: 041 123 456". Kvito never receives or forwards money.
  paymentNote      String?
  /// COMBINED: rent and monthly cost advances are one charge (pavšal); SEPARATE: two charges a month.
  billingMode      BillingMode   @default(SEPARATE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  costEntries       CostEntry[]
  unit              Unit               @relation(fields: [unitId], references: [id])
  members           TenancyMember[]
  invitations       Invitation[]
  charges           Charge[]
  messages          Message[]
  conversationReads ConversationRead[]
  issues            Issue[]
  documents         Document[]
  meterReadings     MeterReading[]
  handovers         Handover[]
  attachments       Attachment[]
  deposit           Deposit?
  costAdvances      CostAdvance[]
  settlements       CostSettlement[]
  rentChanges       RentChange[]

  @@index([unitId])
}

model TenancyMember {
  id               String    @id @default(cuid())
  tenancyId        String
  userId           String
  isPrimary        Boolean   @default(false)
  /// Share in basis points (10000 = 100 %) when splitMethod = PERCENTAGE.
  shareBasisPoints Int?
  /// Number of persons this member represents when splitMethod = PER_PERSON.
  personCount      Int       @default(1)
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenancy Tenancy       @relation(fields: [tenancyId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  shares  ChargeShare[]

  @@unique([tenancyId, userId])
  @@index([userId])
}

/// Invitation link / QR for a tenant. Only a hash of the token is stored.
model Invitation {
  id           String    @id @default(cuid())
  tenancyId    String
  inviterId    String
  email        String?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  tenancy    Tenancy @relation(fields: [tenancyId], references: [id])
  inviter    User    @relation("InvitationInviter", fields: [inviterId], references: [id])
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([tenancyId])
}

// ---------- Charges & payments ----------

model Charge {
  id          String       @id @default(cuid())
  tenancyId   String
  type        ChargeType
  costType    CostType?
  title       String
  description String?
  amountCents Int
  currency    String       @default("EUR")
  dueDate     DateTime     @db.Date
  /// "YYYY-MM" for automatically generated rent; enforces one rent charge per month (idempotent cron).
  rentPeriod  String?
  /// Idempotency key for other generated charges, e.g. "advance:2026-11" (one per tenancy).
  autoKey     String?
  status      ChargeStatus @default(OPEN)
  payTo       PayTo        @default(LANDLORD)
  payeeName   String
  payeeIban   String
  payeeStreet String?
  payeeCity   String?
  /// Payee reference (sklic). For PayTo.SUPPLIER it is copied from the original bill;
  /// for PayTo.LANDLORD each share gets its own RF reference (see ChargeShare.refNo, docs/UPN-QR.md).
  reference   String?
  /// UPN purpose code (4 letters, official ZBS list), e.g. RENT, ELEC.
  purposeCode String?
  purpose     String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  tenancy     Tenancy         @relation(fields: [tenancyId], references: [id])
  createdBy   User?           @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  shares      ChargeShare[]
  attachments Attachment[]
  messages    Message[]
  lines       ChargeLine[]
  deposit     Deposit?
  settlement  CostSettlement?

  @@unique([tenancyId, rentPeriod])
  @@unique([tenancyId, autoKey])
  @@index([tenancyId, status])
  @@index([dueDate])
}

/// A member's part of a charge. Each share is paid, reported and confirmed separately.
model ChargeShare {
  id            String       @id @default(cuid())
  /// Sequential number used in the RF payment reference – allows matching bank statements later.
  refNo         Int          @unique @default(autoincrement())
  chargeId      String
  memberId      String
  amountCents   Int
  status        ChargeStatus @default(OPEN)
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  charge         Charge          @relation(fields: [chargeId], references: [id])
  member         TenancyMember   @relation(fields: [memberId], references: [id])
  confirmedBy    User?           @relation("ChargeShareConfirmedBy", fields: [confirmedById], references: [id])
  paymentReports PaymentReport[]

  @@unique([chargeId, memberId])
  @@index([memberId, status])
}

/// Tenant's "I paid" report, optionally with a proof attachment.
model PaymentReport {
  id            String              @id @default(cuid())
  chargeShareId String
  reportedById  String
  paidOn        DateTime?           @db.Date
  amountCents   Int
  note          String?
  status        PaymentReportStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectReason  String?
  source        PaymentSource       @default(TENANT)
  /// Bank statement entry id (camt AcctSvcrRef or a hash of the row) for BANK_IMPORT.
  bankEntryRef  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  chargeShare ChargeShare  @relation(fields: [chargeShareId], references: [id])
  reportedBy  User         @relation("PaymentReportReporter", fields: [reportedById], references: [id])
  reviewedBy  User?        @relation("PaymentReportReviewer", fields: [reviewedById], references: [id])
  attachments Attachment[]

  @@index([chargeShareId])
}

// ---------- Audit ----------

/// Append-only audit trail of amount/status changes (who, when, before/after).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}

// ---------- Files ----------

enum AttachmentKind {
  BILL
  PAYMENT_PROOF
  MESSAGE
  ISSUE
  METER
  HANDOVER
  DOCUMENT
}

/// A stored file (local disk in development, S3-compatible EU storage in production). Served only via signed URLs.
model Attachment {
  id           String         @id @default(cuid())
  kind         AttachmentKind
  tenancyId    String?
  uploadedById String
  storageKey   String         @unique
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?

  chargeId        String?
  paymentReportId String?
  messageId       String?
  issueId         String?
  issueCommentId  String?
  meterReadingId  String?
  handoverItemId  String?
  documentId      String?
  settlementId    String?
  costEntryId     String?

  costEntry     CostEntry?      @relation(fields: [costEntryId], references: [id])
  tenancy       Tenancy?        @relation(fields: [tenancyId], references: [id])
  uploadedBy    User            @relation(fields: [uploadedById], references: [id])
  charge        Charge?         @relation(fields: [chargeId], references: [id])
  paymentReport PaymentReport?  @relation(fields: [paymentReportId], references: [id])
  message       Message?        @relation(fields: [messageId], references: [id])
  issue         Issue?          @relation(fields: [issueId], references: [id])
  issueComment  IssueComment?   @relation(fields: [issueCommentId], references: [id])
  meterReading  MeterReading?   @relation(fields: [meterReadingId], references: [id])
  handoverItem  HandoverItem?   @relation(fields: [handoverItemId], references: [id])
  document      Document?       @relation(fields: [documentId], references: [id])
  settlement    CostSettlement? @relation(fields: [settlementId], references: [id])

  @@index([tenancyId])
  @@index([uploadedById])
}

// ---------- Messages ----------

enum MessageKind {
  USER
  SYSTEM
}

/// One conversation per tenancy. A message can refer to a charge or an issue.
model Message {
  id          String      @id @default(cuid())
  tenancyId   String
  kind        MessageKind @default(USER)
  authorId    String?
  body        String
  /// For SYSTEM messages: event code (translated on the client) + parameters.
  systemEvent String?
  systemData  Json?
  chargeId    String?
  issueId     String?
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?

  tenancy     Tenancy      @relation(fields: [tenancyId], references: [id])
  author      User?        @relation(fields: [authorId], references: [id])
  charge      Charge?      @relation(fields: [chargeId], references: [id])
  issue       Issue?       @relation(fields: [issueId], references: [id])
  attachments Attachment[]

  @@index([tenancyId, createdAt])
}

/// Read marker per person and conversation ("prebrano").
model ConversationRead {
  tenancyId  String
  userId     String
  lastReadAt DateTime

  tenancy Tenancy @relation(fields: [tenancyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@id([tenancyId, userId])
}

// ---------- Issues ----------

enum IssueCategory {
  PLUMBING
  ELECTRICAL
  HEATING
  APPLIANCE
  WINDOWS_DOORS
  STRUCTURE
  PESTS
  OTHER
}

enum IssueUrgency {
  LOW
  NORMAL
  URGENT
}

enum IssueStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model Issue {
  id          String        @id @default(cuid())
  tenancyId   String
  reporterId  String
  category    IssueCategory
  title       String
  description String
  urgency     IssueUrgency  @default(NORMAL)
  status      IssueStatus   @default(NEW)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  tenancy     Tenancy        @relation(fields: [tenancyId], references: [id])
  reporter    User           @relation(fields: [reporterId], references: [id])
  comments    IssueComment[]
  attachments Attachment[]
  messages    Message[]

  @@index([tenancyId, status])
}

model IssueComment {
  id        String    @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  issue       Issue        @relation(fields: [issueId], references: [id])
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([issueId])
}

// ---------- Documents ----------

enum DocumentCategory {
  CONTRACT
  ANNEX
  HOUSE_RULES
  MANUAL
  OTHER
}

enum DocumentVisibility {
  LANDLORD_ONLY
  TENANTS
}

/// Contract, annexes, house rules, appliance manuals. Belongs to a tenancy or to a unit (manuals outlive tenancies).
model Document {
  id           String             @id @default(cuid())
  tenancyId    String?
  unitId       String?
  category     DocumentCategory
  title        String
  visibility   DocumentVisibility @default(TENANTS)
  uploadedById String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  tenancy     Tenancy?     @relation(fields: [tenancyId], references: [id])
  unit        Unit?        @relation(fields: [unitId], references: [id])
  uploadedBy  User         @relation(fields: [uploadedById], references: [id])
  attachments Attachment[]

  @@index([tenancyId])
  @@index([unitId])
}

// ---------- Meters ----------

enum MeterType {
  ELECTRICITY
  WATER
  GAS
  HEAT
}

/// Meter reading. The value is stored in thousandths of the meter unit (kWh, m³) to avoid floating point.
model MeterReading {
  id           String    @id @default(cuid())
  unitId       String
  tenancyId    String?
  handoverId   String?
  meterType    MeterType
  meterLabel   String?
  valueMilli   BigInt
  readOn       DateTime  @db.Date
  note         String?
  recordedById String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  unit        Unit         @relation(fields: [unitId], references: [id])
  tenancy     Tenancy?     @relation(fields: [tenancyId], references: [id])
  handover    Handover?    @relation(fields: [handoverId], references: [id])
  recordedBy  User         @relation(fields: [recordedById], references: [id])
  attachments Attachment[]

  @@index([unitId, meterType, readOn])
}

// ---------- Handover (move-in / move-out record) ----------

enum HandoverKind {
  MOVE_IN
  MOVE_OUT
}

enum HandoverStatus {
  DRAFT
  AWAITING_CONFIRMATION
  CONFIRMED
}

enum ItemCondition {
  GOOD
  WORN
  DAMAGED
  MISSING
}

model Handover {
  id                  String         @id @default(cuid())
  tenancyId           String
  kind                HandoverKind
  status              HandoverStatus @default(DRAFT)
  handoverOn          DateTime       @db.Date
  keysCount           Int?
  keysNote            String?
  notes               String?
  createdById         String
  landlordConfirmedAt DateTime?
  tenantConfirmedAt   DateTime?
  tenantConfirmedById String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  tenancy           Tenancy        @relation(fields: [tenancyId], references: [id])
  createdBy         User           @relation("HandoverCreatedBy", fields: [createdById], references: [id])
  tenantConfirmedBy User?          @relation("HandoverTenantConfirmedBy", fields: [tenantConfirmedById], references: [id])
  items             HandoverItem[]
  meterReadings     MeterReading[]

  @@index([tenancyId])
}

model HandoverItem {
  id         String        @id @default(cuid())
  handoverId String
  room       String
  name       String
  condition  ItemCondition @default(GOOD)
  note       String?
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  handover    Handover           @relation(fields: [handoverId], references: [id])
  attachments Attachment[]
  deductions  DepositDeduction[]

  @@index([handoverId])
}

// ---------- Notifications ----------

/// In-app notification; also the idempotency record for reminders (dedupeKey).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  url       String?
  data      Json?
  dedupeKey String?   @unique
  pushedAt  DateTime?
  emailedAt DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum PushProvider {
  WEB_PUSH
  FCM
  APNS
}

/// Push target. WEB_PUSH now; FCM/APNs once the app is wrapped with Capacitor.
model PushSubscription {
  id         String       @id @default(cuid())
  userId     String
  provider   PushProvider @default(WEB_PUSH)
  endpoint   String       @unique
  p256dh     String?
  auth       String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------- Contract money: deposit, cost advances, settlements, rent changes (Phase 6) ----------

/// Breakdown of a charge by cost type (monthly advances, settlements).
model ChargeLine {
  id          String   @id @default(cuid())
  chargeId    String
  costType    CostType
  label       String?
  amountCents Int
  sortOrder   Int      @default(0)
  /// Set on a negative line that pays part of the charge with a settlement's credit (pobot dobroimetja).
  creditSettlementId String?

  charge           Charge          @relation(fields: [chargeId], references: [id])
  creditSettlement CostSettlement? @relation("CreditOffset", fields: [creditSettlementId], references: [id])

  @@index([chargeId])
  @@index([creditSettlementId])
}

/// Security deposit (varščina). Kvito only records it – the money moves between the people, outside the app.
///   AWAITING_PAYMENT → (charge confirmed) HELD → propose → RETURN_PROPOSED → accept → RETURN_AGREED → returned → RETURNED
///   RETURN_PROPOSED → dispute → RETURN_DISPUTED → propose again → RETURN_PROPOSED
enum DepositStatus {
  AWAITING_PAYMENT
  HELD
  RETURN_PROPOSED
  RETURN_DISPUTED
  RETURN_AGREED
  RETURNED
}

model Deposit {
  id                 String        @id @default(cuid())
  tenancyId          String        @unique
  amountCents        Int
  status             DepositStatus
  /// Charge the tenant pays the deposit with (null when it was received before Kvito).
  chargeId           String?       @unique
  receivedOn         DateTime?     @db.Date
  returnCents        Int?
  proposalNote       String?
  proposedAt         DateTime?
  disputeReason      String?
  agreedAt           DateTime?
  agreedById         String?
  returnedOn         DateTime?     @db.Date
  /// The tenant confirmed the returned money arrived.
  receiptConfirmedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenancy    Tenancy            @relation(fields: [tenancyId], references: [id])
  charge     Charge?            @relation(fields: [chargeId], references: [id])
  deductions DepositDeduction[]
}

/// A reason the landlord keeps part of the deposit, ideally pointing at a damaged item from the move-out record.
model DepositDeduction {
  id             String   @id @default(cuid())
  depositId      String
  reason         String
  amountCents    Int
  handoverItemId String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  deposit      Deposit       @relation(fields: [depositId], references: [id])
  handoverItem HandoverItem? @relation(fields: [handoverItemId], references: [id])

  @@index([depositId])
}

/// Monthly advance for one cost type (akontacija). Active rows become one ADVANCE charge per month.
model CostAdvance {
  id          String    @id @default(cuid())
  tenancyId   String
  costType    CostType
  amountCents Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenancy Tenancy @relation(fields: [tenancyId], references: [id])

  @@index([tenancyId])
}

/// Settlement of running costs for a period (letni obračun): actual costs vs. charged advances.
///   DRAFT → send → SENT → accept → ACCEPTED → (charge confirmed / refund recorded) → CLOSED
///   SENT → dispute → DISPUTED → send again → SENT
enum SettlementStatus {
  DRAFT
  SENT
  DISPUTED
  ACCEPTED
  CLOSED
}

model CostSettlement {
  id                String           @id @default(cuid())
  tenancyId         String
  periodFrom        DateTime         @db.Date
  periodTo          DateTime         @db.Date
  status            SettlementStatus @default(DRAFT)
  note              String?
  /// Due date of the additional payment when the tenant owes the difference.
  dueDate           DateTime?        @db.Date
  sentAt            DateTime?
  respondedAt       DateTime?
  disputeReason     String?
  /// Charge created on acceptance when the tenant owes the difference.
  chargeId          String?          @unique
  /// Overpayment returned by the landlord (outside Kvito), and the tenant's confirmation.
  refundedOn        DateTime?        @db.Date
  refundConfirmedAt DateTime?
  /// What the landlord suggests doing with a credit, and what the tenant chose on acceptance.
  recommendedChoice    CreditChoice?
  creditChoice         CreditChoice?
  /// Credit not used yet (carried over or being offset against the next charges).
  creditRemainingCents Int           @default(0)
  /// Credit taken over from earlier settlements when this one was sent.
  carriedInCents       Int           @default(0)
  createdById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  tenancy     Tenancy          @relation(fields: [tenancyId], references: [id])
  charge      Charge?          @relation(fields: [chargeId], references: [id])
  lines       SettlementLine[]
  attachments Attachment[]
  offsetLines ChargeLine[]     @relation("CreditOffset")

  @@index([tenancyId])
}

/// What happens with a settlement credit (tenant's choice).
enum CreditChoice {
  /// Stays as credit until the next settlement.
  CARRY_OVER
  /// Deducted from the next monthly charge(s).
  OFFSET_NEXT
  /// Paid back by the landlord.
  REFUND
}

/// Actual running cost for one month and cost type, entered by the landlord as the bills come in.
/// One active entry per (tenancy, period, costType) – partial unique index in the migration.
model CostEntry {
  id          String    @id @default(cuid())
  tenancyId   String
  /// "YYYY-MM"
  period      String
  costType    CostType
  amountCents Int
  note        String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenancy     Tenancy      @relation(fields: [tenancyId], references: [id])
  attachments Attachment[]

  @@index([tenancyId, period])
}

model SettlementLine {
  id           String   @id @default(cuid())
  settlementId String
  costType     CostType
  /// Advances charged for this cost type in the period (computed by the server).
  advanceCents Int
  /// Actual cost per the bills.
  actualCents  Int
  note         String?
  sortOrder    Int      @default(0)

  settlement CostSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
}

/// Rent change from a month on (e.g. yearly indexation per contract). Applied by the rent job.
model RentChange {
  id            String    @id @default(cuid())
  tenancyId     String
  /// First day of the month the new rent applies to.
  effectiveFrom DateTime  @db.Date
  rentCents     Int
  previousCents Int
  note          String?
  createdById   String
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  tenancy Tenancy @relation(fields: [tenancyId], references: [id])

  @@index([tenancyId, effectiveFrom])
}
