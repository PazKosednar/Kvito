// Kvita data model.
// Conventions: money in integer cents (EUR), timestamps in UTC, soft delete via `deletedAt`.
// Models for later phases (Message, Issue, MeterReading, Handover, Document, ...) are added with their own migrations.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  LANDLORD
  TENANT
}

enum Locale {
  sl
  en
}

enum TenancyStatus {
  DRAFT
  ACTIVE
  ENDED
}

/// How a shared cost is split between tenancy members.
enum SplitMethod {
  EQUAL // equal parts
  PERCENTAGE // TenancyMember.shareBasisPoints
  PER_PERSON // weighted by TenancyMember.personCount
}

/// Cost categories a landlord can mark as covered by the tenant. No legal defaults are implied.
enum CostType {
  RENT
  ELECTRICITY
  WATER
  GAS
  HEATING
  WASTE
  INTERNET
  TV
  MAINTENANCE_FUND
  BUILDING_MANAGEMENT
  CLEANING
  OTHER
}

enum ChargeType {
  RENT
  BILL
  OTHER
}

enum ChargeStatus {
  OPEN
  REPORTED_PAID
  CONFIRMED
  OVERDUE
  DISPUTED
}

/// Who receives the payment: the landlord (UPN QR generated by Kvita) or the supplier directly (data from the original bill).
enum PayTo {
  LANDLORD
  SUPPLIER
}

enum PaymentReportStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ---------- Users & auth ----------

model User {
  id             String    @id @default(cuid())
  email          String    @unique // always stored lowercased
  name           String?
  phone          String?
  locale         Locale    @default(sl)
  roles          Role[]    @default([])
  lastActiveRole Role?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  refreshTokens       RefreshToken[]
  properties          Property[]      @relation("PropertyOwner")
  memberships         TenancyMember[]
  invitationsSent     Invitation[]    @relation("InvitationInviter")
  invitationsAccepted Invitation[]    @relation("InvitationAcceptedBy")
  chargesCreated      Charge[]        @relation("ChargeCreatedBy")
  sharesConfirmed     ChargeShare[]   @relation("ChargeShareConfirmedBy")
  paymentReports      PaymentReport[] @relation("PaymentReportReporter")
  paymentReviews      PaymentReport[] @relation("PaymentReportReviewer")
  auditLogs           AuditLog[]
}

/// One-time login code. Only an HMAC of the code is stored.
model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

/// Refresh token session. Rotated on every use; reuse of a rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ip           String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ---------- Properties & tenancies ----------

model Property {
  id         String    @id @default(cuid())
  ownerId    String
  name       String
  street     String
  postalCode String
  city       String
  country    String    @default("SI")
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  owner User   @relation("PropertyOwner", fields: [ownerId], references: [id])
  units Unit[]

  @@index([ownerId])
}

model Unit {
  id         String    @id @default(cuid())
  propertyId String
  name       String
  floor      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  property  Property  @relation(fields: [propertyId], references: [id])
  tenancies Tenancy[]

  @@index([propertyId])
}

model Tenancy {
  id           String        @id @default(cuid())
  unitId       String
  status       TenancyStatus @default(DRAFT)
  startDate    DateTime      @db.Date
  endDate      DateTime?     @db.Date
  rentCents    Int
  /// Day of month rent is due (1-31; clamped to the last day of shorter months).
  rentDueDay   Int
  depositCents Int?
  payeeName    String
  payeeIban    String
  payeeStreet  String?
  payeeCity    String?
  /// Costs the tenant covers, as configured by the landlord.
  coveredCosts CostType[]    @default([])
  splitMethod  SplitMethod   @default(EQUAL)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  unit        Unit            @relation(fields: [unitId], references: [id])
  members     TenancyMember[]
  invitations Invitation[]
  charges     Charge[]

  @@index([unitId])
}

model TenancyMember {
  id               String    @id @default(cuid())
  tenancyId        String
  userId           String
  isPrimary        Boolean   @default(false)
  /// Share in basis points (10000 = 100 %) when splitMethod = PERCENTAGE.
  shareBasisPoints Int?
  /// Number of persons this member represents when splitMethod = PER_PERSON.
  personCount      Int       @default(1)
  joinedAt         DateTime  @default(now())
  leftAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenancy Tenancy       @relation(fields: [tenancyId], references: [id])
  user    User          @relation(fields: [userId], references: [id])
  shares  ChargeShare[]

  @@unique([tenancyId, userId])
  @@index([userId])
}

/// Invitation link / QR for a tenant. Only a hash of the token is stored.
model Invitation {
  id           String    @id @default(cuid())
  tenancyId    String
  inviterId    String
  email        String?
  tokenHash    String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  tenancy    Tenancy @relation(fields: [tenancyId], references: [id])
  inviter    User    @relation("InvitationInviter", fields: [inviterId], references: [id])
  acceptedBy User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([tenancyId])
}

// ---------- Charges & payments ----------

model Charge {
  id          String       @id @default(cuid())
  tenancyId   String
  type        ChargeType
  costType    CostType?
  title       String
  description String?
  amountCents Int
  currency    String       @default("EUR")
  dueDate     DateTime     @db.Date
  /// "YYYY-MM" for automatically generated rent; enforces one rent charge per month (idempotent cron).
  rentPeriod  String?
  status      ChargeStatus @default(OPEN)
  payTo       PayTo        @default(LANDLORD)
  payeeName   String
  payeeIban   String
  payeeStreet String?
  payeeCity   String?
  /// Payment reference (sklic), e.g. "SI00 ..." or "RF..". Format defined in Phase 2 per the UPN QR standard.
  reference   String?
  purposeCode String?
  purpose     String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  tenancy   Tenancy       @relation(fields: [tenancyId], references: [id])
  createdBy User?         @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  shares    ChargeShare[]

  @@unique([tenancyId, rentPeriod])
  @@index([tenancyId, status])
  @@index([dueDate])
}

/// A member's part of a charge. Each share is paid, reported and confirmed separately.
model ChargeShare {
  id            String       @id @default(cuid())
  chargeId      String
  memberId      String
  amountCents   Int
  status        ChargeStatus @default(OPEN)
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  charge         Charge          @relation(fields: [chargeId], references: [id])
  member         TenancyMember   @relation(fields: [memberId], references: [id])
  confirmedBy    User?           @relation("ChargeShareConfirmedBy", fields: [confirmedById], references: [id])
  paymentReports PaymentReport[]

  @@unique([chargeId, memberId])
  @@index([memberId, status])
}

/// Tenant's "I paid" report. Optional proof is linked once Attachment exists (Phase 3).
model PaymentReport {
  id            String              @id @default(cuid())
  chargeShareId String
  reportedById  String
  paidOn        DateTime?           @db.Date
  amountCents   Int
  note          String?
  status        PaymentReportStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  chargeShare ChargeShare @relation(fields: [chargeShareId], references: [id])
  reportedBy  User        @relation("PaymentReportReporter", fields: [reportedById], references: [id])
  reviewedBy  User?       @relation("PaymentReportReviewer", fields: [reviewedById], references: [id])

  @@index([chargeShareId])
}

// ---------- Audit ----------

/// Append-only audit trail of amount/status changes (who, when, before/after).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}
