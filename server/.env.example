# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4180
LOG_LEVEL=debug

# PostgreSQL (local install, see README). Password must be URL-encoded.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/kvita?schema=public"
# Separate database for automated tests (created automatically by `prisma migrate deploy`).
DATABASE_URL_TEST="postgresql://postgres:CHANGE_ME@localhost:5432/kvita_test?schema=public"

# Public URL of the web client (CORS + links in e-mails).
CLIENT_ORIGIN=http://localhost:5180

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_RANDOM

ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Set to true behind HTTPS (production).
COOKIE_SECURE=false

# --- Files -------------------------------------------------------------------------------------------
# Development: local folder (created on server start). Production: S3-compatible storage in the EU.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# STORAGE_DRIVER=s3
# S3_BUCKET=kvito-files
# S3_REGION=eu-central-1
# S3_ENDPOINT=            # only for S3-compatible providers other than AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- E-mail (required in production) -----------------------------------------------------------------
# Without SMTP_HOST e-mails (login codes!) are only printed to the console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false       # true for port 465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Kvito <obvestila@kvito.si>
# Test deployment without SMTP only: e-mails (login codes!) go to the server log. Never with real users.
# EMAIL_CONSOLE_IN_PRODUCTION=false
# Temporary: sign-up without the e-mailed code (the account is signed in at once, e-mail stays unconfirmed).
# SKIP_EMAIL_VERIFICATION=false

# --- Web Push (optional) -----------------------------------------------------------------------------
# Generate a key pair with: npm run vapid -w server. Without keys push is off and e-mail is used instead.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:podpora@kvito.si

# --- One service (production) ------------------------------------------------------------------------
# The server also delivers the built web client. Default: on in production, off in development.
# SERVE_CLIENT=true

# Kvito pomočnik za najemodajalce (Claude API). Brez ključa je pomočnik izklopljen.
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5

# Omejitve paketov (enote, prostor za datoteke, docs/NAROCNINA.md). Med testnim obdobjem izklopljeno:
# Kvito je brezplačen za vse brez omejitev. Vklopi ob koncu testnega obdobja.
# PLAN_LIMITS_ENABLED=false

# --- Naročnine: Polar (polar.sh, Merchant of Record) ------------------------------------------------
# Plačila so vklopljena samo, ko so nastavljeni ŽETON, WEBHOOK SKRIVNOST in VSEH 6 ID-jev izdelkov.
# Brez njih stran Naročnina pokaže »kmalu« in aplikacija deluje kot prej.
# sandbox = testno okolje (sandbox.polar.sh, kartica 4242 4242 4242 4242), production = prava plačila.
# Žeton, izdelki in skrivnost so vezani na okolje (sandbox in production sta ločena). Glej docs/POLAR_SETUP.md.
# POLAR_SERVER=sandbox
# Organization Access Token (Polar → Settings → Developers). Pravice: checkouts:write, customer_sessions:write.
# POLAR_ACCESS_TOKEN=
# Skrivnost webhooka (Polar → Settings → Webhooks), oblika whsec_..., vpiši jo točno takšno.
# URL webhooka: https://<domena>/api/webhooks/polar, format Raw, dogodki subscription.*
# POLAR_WEBHOOK_SECRET=
# ID-ji izdelkov (Polar → Products). Vsak izdelek ima v metadata še plan=PLUS|PRO|MANAGER in interval=month|year.
# POLAR_PRODUCT_PLUS_MONTHLY=
# POLAR_PRODUCT_PLUS_YEARLY=
# POLAR_PRODUCT_PRO_MONTHLY=
# POLAR_PRODUCT_PRO_YEARLY=
# POLAR_PRODUCT_MANAGER_MONTHLY=
# POLAR_PRODUCT_MANAGER_YEARLY=
# Popust za ustanovne uporabnike (−30 %, forever). Uporabi se samo za račune z oznako founder.
# POLAR_FOUNDER_DISCOUNT_ID=
